# Kết nối cơ sở dữ liệu
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Xác thực và CORS
JWT_SECRET=
AUTH_REFRESH_COOKIE_SECURE=
AUTH_REFRESH_COOKIE_SAME_SITE=
CORS_ALLOWED_ORIGINS=

# Tài nguyên và credential AWS hiện tại
AWS_S3_BUCKET_RAW=
AWS_S3_BUCKET_HLS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MEDIACONVERT_ROLE_ARN=
AWS_SQS_VIDEO_EVENTS_QUEUE_URL=
AWS_SQS_VIDEO_UPLOAD_EVENTS_QUEUE_URL=

# Timeout/retry cho AWS SDK, không đổi static access key
AWS_CLIENT_CONNECTION_TIMEOUT=2s
AWS_CLIENT_API_CALL_ATTEMPT_TIMEOUT=30s
AWS_CLIENT_API_CALL_TIMEOUT=3m
AWS_CLIENT_MAX_ATTEMPTS=4

# Lưu trữ ảnh
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gửi email
MAIL_USERNAME=
MAIL_PASSWORD=

# Thanh toán MoMo
BRAND=learnhub
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=
MOMO_RETURN_URL=
MOMO_NOTIFY_URL=

# Thanh toán PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
PAYPAL_CURRENCY=
EXCHANGE_RATE_BASE_URL=

# Gemini và Qdrant
GOOGLE_GENAI_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=
LEARNHUB_VECTOR_BACKFILL_ON_STARTUP=false

# Múi giờ ứng dụng và session DB
APP_TIME_ZONE=Asia/Ho_Chi_Minh
DB_SESSION_TIME_ZONE=+07:00

# Pool kết nối DB
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=10
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# Pool async và scheduler
ASYNC_CORE_POOL_SIZE=8
# Max/queue dưới đây giữ trạng thái gần như không giới hạn hiện tại
ASYNC_MAX_POOL_SIZE=2147483647
ASYNC_QUEUE_CAPACITY=2147483647
SCHEDULER_POOL_SIZE=1

# Cấu hình nhận message SQS
AWS_SQS_LISTENER_AUTO_STARTUP=true
AWS_SQS_MAX_CONCURRENT_MESSAGES=1
AWS_SQS_MAX_MESSAGES_PER_POLL=1
AWS_SQS_POLL_TIMEOUT_SECONDS=20

# SSE, lịch cleanup và cache HLS
APP_SSE_TIMEOUT_MS=1800000
APP_SSE_HEARTBEAT_MS=15000
SESSION_CLEANUP_DELAY_MS=3600000
PAYMENT_EXPIRATION_SCAN_DELAY_MS=300000
HLS_PRIVATE_CACHE_MAX_AGE_SECONDS=3600

# Cache xác thực và quyền xem video
AUTH_CACHE_MAXIMUM_SIZE=20000
AUTH_CACHE_EXPIRE_AFTER_WRITE_MINUTES=15
AUTH_CACHE_GENERATION_EXTRA_TTL_MINUTES=5
VIDEO_PLAYBACK_CACHE_METADATA_MAXIMUM_SIZE=10000
VIDEO_PLAYBACK_CACHE_METADATA_TTL_MINUTES=30
VIDEO_PLAYBACK_CACHE_ACCESS_MAXIMUM_SIZE=50000
VIDEO_PLAYBACK_CACHE_ACCESS_TTL_MINUTES=5

# Capacity và TTL của cache ứng dụng
APP_CACHE_CATEGORIES_MAXIMUM_SIZE=4
APP_CACHE_CATEGORIES_EXPIRE_AFTER_WRITE=12h
APP_CACHE_COURSE_RATING_STATS_MAXIMUM_SIZE=10000
APP_CACHE_COURSE_RATING_STATS_EXPIRE_AFTER_WRITE=30m
APP_CACHE_COURSE_RATING_SUMMARIES_MAXIMUM_SIZE=10000
APP_CACHE_COURSE_RATING_SUMMARIES_EXPIRE_AFTER_WRITE=30m
APP_CACHE_PUBLIC_COURSE_DETAILS_MAXIMUM_SIZE=2000
APP_CACHE_PUBLIC_COURSE_DETAILS_EXPIRE_AFTER_WRITE=2h
APP_CACHE_PUBLIC_COURSE_CATALOG_MAXIMUM_SIZE=32
APP_CACHE_PUBLIC_COURSE_CATALOG_EXPIRE_AFTER_WRITE=1m
